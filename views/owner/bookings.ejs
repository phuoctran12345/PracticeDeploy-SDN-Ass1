<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container my-4">
  <h1 class="mb-4">Booking của Owner</h1>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form method="GET" action="/owner/bookings" class="row g-3 align-items-end">
        <div class="col-auto">
          <label class="form-label">UserId (owner)</label>
          <input type="text" name="userId" class="form-control" placeholder="ObjectId của owner" value="<%= typeof owner !== 'undefined' && owner && owner._id ? owner._id : '' %>" style="width:220px;">
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-primary">Xem</button>
        </div>
      </form>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger mt-3 mb-0"><%= error %></div>
      <% } %>
    </div>
  </div>
  <% if (bookings && bookings.length) { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr><th>Xe</th><th>Khách</th><th>Bắt đầu</th><th>Kết thúc</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b) { %>
              <tr>
                <td><%= b.carId ? (b.carId.brand + ' ' + b.carId.model) : '-' %></td>
                <td><%= b.userId ? b.userId.name : '-' %></td>
                <td><%= b.startDate ? new Date(b.startDate).toLocaleDateString('vi-VN') : '-' %></td>
                <td><%= b.endDate ? new Date(b.endDate).toLocaleDateString('vi-VN') : '-' %></td>
                <td><%= b.totalPrice != null ? b.totalPrice.toLocaleString('vi-VN') : '-' %> đ</td>
                <td><span class="badge bg-<%= b.bookingStatus === 'completed' ? 'success' : b.bookingStatus === 'cancelled' ? 'secondary' : 'info' %>"><%= b.bookingStatus %></span></td>
                <td><a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else if (!error) { %>
    <div class="alert alert-info">Nhập userId (owner) và bấm Xem, hoặc chưa có booking.</div>
  <% } %>
</div>
<%- include('../partials/footer') %>
