<%- include('../partials/header') %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('../partials/navbar') %>

    <div class="container my-4">
      <h1 class="mb-4">Quản lý đơn đặt xe (Admin)</h1>
      <% if (typeof ok !=='undefined' && ok==='confirmed' ) { %>
        <div class="alert alert-success py-2">Đã xác nhận đơn.</div>
        <% } %>
          <% if (typeof ok !=='undefined' && ok==='cancelled' ) { %>
            <div class="alert alert-secondary py-2">Đã hủy đơn.</div>
            <% } %>
              <% if (typeof err !=='undefined' && err==='notfound' ) { %>
                <div class="alert alert-danger py-2">Không tìm thấy đơn.</div>
                <% } %>
                  <% if (typeof err !=='undefined' && err==='already' ) { %>
                    <div class="alert alert-warning py-2">Đơn đã được xử lý trước đó.</div>
                    <% } %>

                      <p class="mb-3">
                        <a href="/admin/summary" class="btn btn-outline-primary btn-sm"><i
                            class="bi bi-bar-chart me-1"></i>Tổng hợp</a>
                      </p>

                      <% if (bookings && bookings.length) { %>
                        <div class="card shadow-sm">
                          <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                              <thead class="table-light">
                                <tr>
                                  <th>ID</th>
                                  <th>Xe</th>
                                  <th>Khách</th>
                                  <th>Bắt đầu</th>
                                  <th>Kết thúc</th>
                                  <th>Tổng tiền</th>
                                  <th>Trạng thái</th>
                                  <th>Thao tác</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% bookings.forEach(function(b) { %>
                                  <tr>
                                    <td><small>
                                        <%= b._id %>
                                      </small></td>
                                    <td>
                                      <%= b.carId ? (b.carId.brand + ' ' + b.carId.model) : '-' %>
                                    </td>
                                    <td>
                                      <%= b.userId ? (b.userId.name + ' / ' + b.userId.email) : '-' %>
                                    </td>
                                    <td>
                                      <%= b.startDate ? new Date(b.startDate).toLocaleDateString('vi-VN') : '-' %>
                                    </td>
                                    <td>
                                      <%= b.endDate ? new Date(b.endDate).toLocaleDateString('vi-VN') : '-' %>
                                    </td>
                                    <td>
                                      <%= b.totalPrice !=null ? b.totalPrice.toLocaleString('vi-VN') : '-' %> đ
                                    </td>
                                    <td>
                                      <span
                                        class="badge bg-<%= b.bookingStatus === 'completed' ? 'success' : b.bookingStatus === 'cancelled' ? 'secondary' : b.bookingStatus === 'confirmed' ? 'info' : 'warning text-dark' %>">
                                        <%= b.bookingStatus %>
                                      </span>
                                    </td>
                                    <td>
                                      <% if (b.bookingStatus==='pending' ) { %>
                                        <form method="POST" action="/admin/bookings/<%= b._id %>/confirm"
                                          class="d-inline">
                                          <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                                        </form>
                                        <form method="POST" action="/admin/bookings/<%= b._id %>/cancel"
                                          class="d-inline">
                                          <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                        </form>
                                        <% } else { %>
                                          <span class="text-muted small">—</span>
                                          <% } %>
                                            <a href="/bookings/<%= b._id %>"
                                              class="btn btn-sm btn-outline-primary ms-1">Chi tiết</a>
                                    </td>
                                  </tr>
                                  <% }); %>
                              </tbody>
                            </table>
                          </div>
                        </div>
                        <% } else { %>
                          <div class="alert alert-info">Chưa có đơn đặt xe nào.</div>
                          <% } %>
    </div>

    <%- include('../partials/footer') %>