<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container my-4">
  <h1 class="mb-4">Danh sách đặt xe (Rentals)</h1>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form method="GET" action="/bookings" class="row g-3 align-items-end mb-3">
        <div class="col-auto">
          <label class="form-label">Lọc theo userId</label>
          <input type="text" name="userId" value="<%= filterUserId %>" placeholder="ObjectId" class="form-control" style="width:220px;">
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-primary">Lọc</button>
        </div>
      </form>
      <a href="/bookings/new" class="btn btn-primary">Tạo đặt xe mới</a>
    </div>
  </div>
  <% if (bookings && bookings.length) { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th><th>Xe</th><th>Khách</th><th>Bắt đầu</th><th>Kết thúc</th><th>Tổng tiền</th><th>Trạng thái</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b) { %>
              <tr>
                <td><small><%= b._id %></small></td>
                <td><%= b.carId ? (b.carId.brand + ' ' + b.carId.model) : b.carId %></td>
                <td><%= b.userId ? b.userId.name : b.userId %></td>
                <td><%= b.startDate ? new Date(b.startDate).toLocaleDateString('vi-VN') : '-' %></td>
                <td><%= b.endDate ? new Date(b.endDate).toLocaleDateString('vi-VN') : '-' %></td>
                <td><%= b.totalPrice != null ? b.totalPrice.toLocaleString('vi-VN') : '-' %> đ</td>
                <td><span class="badge bg-<%= b.bookingStatus === 'completed' ? 'success' : b.bookingStatus === 'cancelled' ? 'secondary' : b.bookingStatus === 'confirmed' ? 'info' : 'warning text-dark' %>"><%= b.bookingStatus %></span></td>
                <td><a href="/bookings/<%= b._id %>" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-info">Chưa có đặt xe nào.</div>
  <% } %>
</div>
<%- include('../partials/footer') %>
