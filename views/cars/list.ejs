<%- include('../partials/header') %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('../partials/navbar') %>

    <div class="page-cars-list">
      <div class="container py-4 py-lg-5">
        <!-- Header section -->
        <div class="cars-page-header mb-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
              <span class="page-badge">Danh mục</span>
              <h1 class="page-title">Danh sách xe</h1>
              <p class="page-subtitle text-muted mb-0">Chọn xe phù hợp với hành trình của bạn</p>
            </div>
            <a href="/" class="btn btn-outline-primary">
              <i class="bi bi-arrow-left me-1"></i> Về trang chủ
            </a>
          </div>
        </div>

        <!-- Filter card -->
        <div class="filter-card mb-4">
          <form method="GET" action="/cars" class="filter-form">
            <div class="row g-3 align-items-center">
              <div class="col-auto">
                <label class="form-label mb-0 fw-500">
                  <i class="bi bi-funnel me-1"></i> Lọc theo trạng thái
                </label>
              </div>
              <div class="col-auto">
                <select name="status" class="form-select form-select-filter">
                  <option value="">Tất cả</option>
                  <option value="AVAILABLE" <%=currentStatus==='AVAILABLE' ? 'selected' : '' %>>Có sẵn</option>
                  <option value="RENTED" <%=currentStatus==='RENTED' ? 'selected' : '' %>>Đang thuê</option>
                  <option value="MAINTENANCE" <%=currentStatus==='MAINTENANCE' ? 'selected' : '' %>>Bảo trì</option>
                </select>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-filter">
                  <i class="bi bi-search me-1"></i> Lọc
                </button>
              </div>
              <% if (currentStatus) { %>
                <div class="col-auto">
                  <a href="/cars" class="btn btn-outline-secondary btn-sm">Bỏ lọc</a>
                </div>
                <% } %>
            </div>
          </form>
        </div>

        <% if (cars && cars.length) { %>
          <div class="cars-count mb-3">
            <span class="text-muted">Hiển thị <strong>
                <%= cars.length %>
              </strong> xe</span>
          </div>
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% cars.forEach(function(car) { var brand=(car.brand || '' ).toLowerCase(); var
              imgUrl='https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=400&h=250&fit=crop' ; if
              (brand.indexOf('toyota') !==-1)
              imgUrl='https://images.unsplash.com/photo-1621007947382-bb3c3994e3fb?w=400&h=250&fit=crop' ; else if
              (brand.indexOf('honda') !==-1)
              imgUrl='https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=400&h=250&fit=crop' ; else if
              (brand.indexOf('bmw') !==-1)
              imgUrl='https://images.unsplash.com/photo-1555215695-3004980ad54e?w=400&h=250&fit=crop' ; else if
              (brand.indexOf('mercedes') !==-1)
              imgUrl='https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=400&h=250&fit=crop' ; else if
              (brand.indexOf('audi') !==-1)
              imgUrl='https://images.unsplash.com/photo-1619682817481-e994891cd1f5?w=400&h=250&fit=crop' ; else if
              (brand.indexOf('ford') !==-1)
              imgUrl='https://images.unsplash.com/photo-1584345604476-8ec5f82f0b8c?w=400&h=250&fit=crop' ; %>
              <div class="col">
                <div class="car-card-list">
                  <a href="/cars/<%= car._id %>" class="car-card-link">
                    <div class="car-card-image">
                      <img src="<%= imgUrl %>" alt="<%= car.brand %> <%= car.model %>" loading="lazy">
                      <span
                        class="car-card-badge car-badge-<%= car.status === 'AVAILABLE' ? 'success' : car.status === 'RENTED' ? 'warning' : 'danger' %>">
                        <%= car.status==='AVAILABLE' ? 'Có sẵn' : car.status==='RENTED' ? 'Đang thuê' : 'Bảo trì' %>
                      </span>
                    </div>
                    <div class="car-card-body">
                      <h5 class="car-card-title">
                        <%= car.brand %>
                          <%= car.model %>
                      </h5>
                      <p class="car-card-id">
                        <i class="bi bi-upc-scan me-1"></i>
                        <%= car.carId %>
                      </p>
                      <div class="car-card-price">
                        <span class="price-value">
                          <%= car.pricePerDay.toLocaleString('vi-VN') %>
                        </span>
                        <span class="price-unit">đ/ngày</span>
                      </div>
                      <span class="btn btn-primary btn-sm w-100 mt-2">
                        <i class="bi bi-eye me-1"></i> Xem chi tiết
                      </span>
                    </div>
                  </a>
                </div>
              </div>
              <% }); %>
          </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon">
                <i class="bi bi-car-front"></i>
              </div>
              <h3 class="empty-state-title">Chưa có xe nào</h3>
              <p class="empty-state-text text-muted">Thử bỏ bộ lọc hoặc quay lại sau.</p>
              <a href="/cars" class="btn btn-primary">Xem tất cả</a>
            </div>
            <% } %>
      </div>
    </div>

    <%- include('../partials/footer') %>