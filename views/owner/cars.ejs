<%- include('../partials/header') %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <%- include('../partials/navbar') %>

    <div class="container my-4">
      <h1 class="mb-4">Xe của tôi</h1>
      <p class="mb-3">
        <a href="/owner/bookings" class="btn btn-outline-primary btn-sm"><i
            class="bi bi-calendar-check me-1"></i>Booking xe của tôi</a>
        <a href="/owner/cars/new" class="btn btn-primary btn-sm ms-2"><i class="bi bi-plus-lg me-1"></i>Thêm xe</a>
      </p>

      <% if (cars && cars.length) { %>
        <div class="card shadow-sm">
          <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Mã xe</th>
                  <th>Hãng / Model</th>
                  <th>Giá/ngày</th>
                  <th>Trạng thái</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% cars.forEach(function(c) { %>
                  <tr>
                    <td>
                      <%= c.carId %>
                    </td>
                    <td>
                      <%= c.brand %>
                        <%= c.model %>
                    </td>
                    <td>
                      <%= c.pricePerDay !=null ? c.pricePerDay.toLocaleString('vi-VN') : '-' %> đ
                    </td>
                    <td><span
                        class="badge bg-<%= c.status === 'AVAILABLE' ? 'success' : c.status === 'RENTED' ? 'warning text-dark' : 'secondary' %>">
                        <%= c.status %>
                      </span></td>
                    <td><a href="/cars/<%= c._id %>" class="btn btn-sm btn-outline-primary">Xem</a></td>
                  </tr>
                  <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <p class="text-muted small mt-3">Khách đặt xe sẽ hiển thị tại <a href="/owner/bookings">Booking xe của tôi</a>,
          bạn có thể xác nhận hoặc hủy đơn tại đó.</p>
        <% } else { %>
          <div class="alert alert-info">
            <strong>Bạn chưa có xe nào.</strong> Thêm xe để khách có thể đặt và bạn duyệt yêu cầu tại trang "Booking xe
            của tôi".
            <p class="mb-0 mt-2"><a href="/owner/cars/new" class="btn btn-primary">Thêm xe ngay</a></p>
          </div>
          <% } %>
    </div>

    <%- include('../partials/footer') %>